# CivicPulse local environment
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every value below is a development default and is safe to publish.

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
# Name, user and password of the application database created by the db container.
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
# Development-only password. Use a generated secret anywhere else.
POSTGRES_PASSWORD=civicpulse-dev-only
# Host port for connecting a local SQL client to the database container.
POSTGRES_HOST_PORT=5432

# --- Backend (Spring Boot) -------------------------------------------------
# JDBC URL used by the backend container; `db` is the compose service name.
CIVICPULSE_DB_URL=jdbc:postgresql://db:5432/civicpulse
# Comma-separated Spring profiles. `demo` will load seed data (from Phase 2 on).
SPRING_PROFILES_ACTIVE=demo
# Browser origins allowed by CORS. Compose serves frontend and API from one
# origin through nginx, so this only matters when running `ng serve` separately.
CIVICPULSE_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Structured JSON log format in containers: `ecs` (default) or `logstash`.
# Running the backend outside Docker logs human-readable text instead.
CIVICPULSE_LOG_FORMAT=ecs

# --- Frontend (nginx) ------------------------------------------------------
# Host port where the application is served (SPA + /api proxy).
CIVICPULSE_HTTP_PORT=8080
