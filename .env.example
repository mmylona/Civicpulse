# Copy to .env to override the defaults. Never commit .env.

POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse-dev-only
# host port for a local SQL client (5433 avoids clashing with a local PostgreSQL)
POSTGRES_HOST_PORT=5433

CIVICPULSE_DB_URL=jdbc:postgresql://db:5432/civicpulse
# `demo` creates the demo accounts listed in the README
SPRING_PROFILES_ACTIVE=demo
# only needed when the frontend runs on `ng serve`
CIVICPULSE_CORS_ALLOWED_ORIGINS=http://localhost:4200
# ecs or logstash
CIVICPULSE_LOG_FORMAT=ecs
# signs access tokens; at least 32 bytes. Generate one with: openssl rand -base64 48
CIVICPULSE_JWT_SECRET=civicpulse-dev-only-jwt-secret-change-me
# set to false only if your browser rejects Secure cookies on http://localhost
CIVICPULSE_COOKIE_SECURE=true

CIVICPULSE_HTTP_PORT=8080
